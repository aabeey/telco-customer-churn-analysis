      <column caption='Chrun Rate' datatype='real' name='[Calculation_0394313180188672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Churn] = &quot;Yes&quot;&#10;THEN [customerID]&#10;END&#10;)&#10;/&#10;COUNTD([customerID])' />
